  "description": "Trasforma i tuoi EPUB in audiolibri. 100% lato client, offline-first, zero costi.",
  "start_url": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "id": "./",
  "icons": [
    {
      "src": "public/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "public/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/epub+zip": [".epub"]
      }
    }
  ],
  "categories": ["books", "productivity", "utilities"],
  "lang": "it",
  "shortcuts": [
    {
      "name": "Libreria",
      "url": "./?view=library",
      "icons": [{ "src": "public/icons/icon-192.svg", "sizes": "192x192" }]
    }
  ]
